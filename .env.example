# Conexión PostgreSQL de Supabase: directa o Session pooler, con contraseña URL-encoded.
# Usar el panel Connect de Supabase. Nunca colocar estos valores en src/frontend.
SUPABASE_DB_URL=
# Ruta absoluta al certificado CA para sslmode=verify-full.
SUPABASE_SSLROOTCERT=
# Mantener sqlite hasta completar la migración definitiva autorizada.
VITADEV_DATABASE=sqlite
VITADEV_DB_SCHEMA=vitadev
# No se requiere anon key/service_role key: esta etapa usa PostgreSQL desde Python.
